{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r4d.p5.assets/1",
  "type": "object",
  "required": ["schema", "status", "sourceSha256", "p1Commit", "lighting", "textures", "instances"],
  "properties": {
    "schema": {"const": "r4d.p5.assets/1"},
    "status": {"enum": ["example-not-renderable", "partial", "candidate"]},
    "sourceSha256": {"const": "c8f9e4245c1de8c2086e615bc75dc10aea59b76b614d6e106593e07262e24f72"},
    "p1Commit": {"const": "4b47db04c7140ebf88f69b91faa0b790d46f22ec"},
    "lighting": {"type": "object", "required": ["description", "shadowDirectionSourcePx"], "properties": {"description": {"type": "string"}, "shadowDirectionSourcePx": {"$ref": "#/$defs/point"}}},
    "textures": {"type": "array", "items": {"$ref": "#/$defs/texture"}},
    "instances": {"type": "array", "items": {"$ref": "#/$defs/instance"}}
  },
  "$defs": {
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "bbox": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
    "texture": {
      "type": "object", "required": ["id", "family", "file", "sha256", "bytes", "sizePx", "alpha", "groundAnchorPx", "footprintPx", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "family": {"type": "string"}, "file": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1},
        "sizePx": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
        "alpha": {"type": "object", "required": ["policy", "bounds", "visibleBounds"], "properties": {"policy": {"enum": ["straight-rgba", "opaque"]}, "bounds": {"$ref": "#/$defs/bbox"}, "visibleBounds": {"$ref": "#/$defs/bbox"}}},
        "groundAnchorPx": {"$ref": "#/$defs/point"},
        "footprintPx": {"type": "object", "required": ["center", "width", "depth"], "properties": {"center": {"$ref": "#/$defs/point"}, "width": {"type": "number", "exclusiveMinimum": 0}, "depth": {"type": "number", "exclusiveMinimum": 0}}},
        "provenance": {"type": "object", "required": ["method", "promptPath", "toolOutputId", "rawSha256", "corrections"], "properties": {"method": {"const": "generated"}, "promptPath": {"type": "string"}, "toolOutputId": {"type": "string"}, "rawSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "corrections": {"type": "array"}}}
      }
    },
    "instance": {
      "type": "object", "required": ["id", "textureId", "targetId", "parentId", "role", "depthOffsetRadii", "depthReason"],
      "properties": {
        "id": {"type": "string"}, "textureId": {"type": "string"}, "targetId": {"type": "string"}, "parentId": {"type": "string"},
        "role": {"enum": ["floor", "shadow", "body", "receiver-back", "receiver-front", "ball", "foreground"]},
        "depthOffsetRadii": {"type": "number", "minimum": -1, "maximum": 1}, "depthReason": {"type": "string"}
      }
    }
  }
}
