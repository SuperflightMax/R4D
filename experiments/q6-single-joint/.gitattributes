# Preserve candidate/provenance bytes independently of core.autocrlf.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Frozen lock contains an existing final empty line; preserve accepted bytes.
package-lock.json whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
