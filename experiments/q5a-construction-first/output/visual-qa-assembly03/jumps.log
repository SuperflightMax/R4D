   if([2,5,8].includes(k))await command('Прыжок ↑');
   await snap(`J-${i}-${String(k).padStart(2,'0')}`,'jump phases, targets/repeated jump');
  }
 }
 return {method:'paused live engine 12 fixed steps per image; UI commands',rows,commands};
}
