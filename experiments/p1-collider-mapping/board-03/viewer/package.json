{
  "name": "r4d-p1-collider-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:inputs": "node scripts/check-inputs.mjs",
    "prepare:assets": "node scripts/prepare-viewer-assets.mjs",
    "dev": "npm run check:inputs && npm run prepare:assets && vite",
    "build": "npm run check:inputs && npm run prepare:assets && tsc --noEmit && vite build",
    "candidate:manifest": "node scripts/check-release.mjs --write-manifest",
    "check:release": "node scripts/check-release.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build && npm run check:release"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

